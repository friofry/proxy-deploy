# Copy to .env and fill in. The file is sourced by bash:
# put values with special characters in 'single quotes'.

# --- Domains (one per proxy). Caddy serves a name only once its DNS points at the host.
MARKET_DOMAIN=market.example.org
RPC_DOMAIN=rpc.example.org
NFT_DOMAIN=nft.example.org
# More names for a proxy, comma-separated (optional): MARKET_EXTRA_DOMAINS,
# RPC_EXTRA_DOMAINS, NFT_EXTRA_DOMAINS. Served by the same rule as the main one.
MARKET_EXTRA_DOMAINS=
# Contact address for Let's Encrypt (optional but recommended).
ACME_EMAIL=

# Who terminates TLS:
#   caddy - this host is the edge, Caddy gets Let's Encrypt certificates (one host).
#   lb    - a load balancer terminates TLS and sends plain HTTP to port 80 (several hosts).
TLS_MODE=caddy

# The next three settings apply to TLS_MODE=caddy only.
# Also serve <proxy>.<ip-with-dashes>.sslip.io so the host can be tested before DNS is switched.
SSLIP_TEST_DOMAINS=1
# Set to 1 if the domains sit behind a CDN/LB, so their DNS never resolves to this host directly.
FORCE_DOMAINS=0
# Public IPv4 of the host. Detected from the default route when empty.
PUBLIC_IP=

# --- What to deploy
MARKET_REPO=https://github.com/status-im/market-proxy.git
MARKET_REF=deploy-prod
RPC_REPO=https://github.com/status-im/eth-rpc-proxy.git
RPC_REF=deploy-prod
NFT_REPO=https://github.com/status-im/nft-proxy.git
NFT_REF=deploy-prod

# --- Basic auth. Must match what the apps already ship with, or they get 401.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Optional per-proxy overrides: MARKET_BASIC_AUTH_USER, MARKET_BASIC_AUTH_PASSWORD,
# RPC_BASIC_AUTH_USER, RPC_BASIC_AUTH_PASSWORD, NFT_BASIC_AUTH_USER, NFT_BASIC_AUTH_PASSWORD.
# A second pair a proxy accepts next to its own (optional), for a host that answers
# to two names whose clients ship different passwords: MARKET_EXTRA_BASIC_AUTH_USER,
# MARKET_EXTRA_BASIC_AUTH_PASSWORD (same for RPC_ and NFT_). The name must differ.
# 1: market-proxy takes ANY basic auth name and password (a request without
# credentials is still a 401, a puzzle JWT works as before). For a host that has
# to serve clients whose pair it does not have. Applied by the up step.
MARKET_ANY_BASIC_AUTH=0

# --- Puzzle auth. Signs puzzles and JWTs; every host behind one name must share it.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Optional per-proxy overrides: MARKET_JWT_SECRET, RPC_JWT_SECRET, NFT_JWT_SECRET.

# --- Provider keys
INFURA_API_KEY=
ALCHEMY_API_KEY=
# Alchemy key for nft-proxy; falls back to ALCHEMY_API_KEY.
NFT_ALCHEMY_API_KEY=
# Comma-separated. Both may be empty: market-fetcher then runs keyless (30 req/min).
COINGECKO_API_KEYS=
COINGECKO_DEMO_API_KEYS=

# --- Shared L2 cache for eth-rpc-proxy (optional).
# Empty: KeyDB is disabled, each host keeps only its in-memory cache.
# Example: redis://:password@10.0.0.5:6379
KEYDB_URL=

# --- DigitalOcean, used only by provision.sh (doctl must be authorized).
# Droplets are named <tag>-1, <tag>-2, ...; the balancer <tag>-lb, the firewall <tag>-fw.
DO_TAG=proxy
DO_REGION=fra1
DO_SIZE=s-2vcpu-4gb
DO_IMAGE=ubuntu-24-04-x64
# Comma-separated key IDs or fingerprints from: doctl compute ssh-key list
DO_SSH_KEYS=
# Certificate for the balancer, from: doctl compute certificate list
DO_CERT_ID=
